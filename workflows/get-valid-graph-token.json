        "query": "UPDATE tenant_credentials\nSET\n  access_token = pgp_sym_encrypt('{{ $json.access_token.replace(/'/g, \"''\") }}', '{{ $env.TENANT_TOKEN_SECRET }}'),\n  refresh_token = pgp_sym_encrypt('{{ $json.refresh_token.replace(/'/g, \"''\") }}', '{{ $env.TENANT_TOKEN_SECRET }}'),\n  expires_at = NOW() + INTERVAL '{{ $json.expires_in }} seconds',\n  updated_at = NOW()\nWHERE tenant_id = '{{ $('When Executed by Another Workflow').first().json.tenantId.replace(/'/g, \"''\") }}' AND provider = 'outlook'\nRETURNING access_token IS NOT NULL AS success;",

      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0,0,0,0);\nconst expiry = new Date(2026, 10, 24); // Azure Client Secret Ablauf: 24.11.2026\nconst msPerDay = 24 * 60 * 60 * 1000;\nconst daysRemaining = Math.round((expiry - today) / msPerDay);\n\nconst milestones = [30, 14, 7, 3, 1, 0];\nconst shouldWarn = milestones.includes(daysRemaining) || daysRemaining < 0;\n\nconst chatId = $input.first().json.value;\n\nlet text;\nif (daysRemaining < 0) {\n  text = `🔴 Azure Client Secret ist seit ${Math.abs(daysRemaining)} Tag(en) ABGELAUFEN. Outlook-Verbindung fuer ALLE Kunden betroffen -- jetzt im Azure Portal erneuern.`;\n} else if (daysRemaining === 0) {\n  text = `🔴 Azure Client Secret laeuft HEUTE ab (24.11.2026). Outlook-Verbindung fuer ALLE Kunden betroffen -- jetzt erneuern.`;\n} else {\n  text = `⚠️ Azure Client Secret laeuft in ${daysRemaining} Tag(en) ab (24.11.2026). Betrifft die Outlook-Verbindung aller Kunden gleichzeitig -- rechtzeitig im Azure Portal erneuern.`;\n}\n\nreturn [{ json: { shouldWarn, daysRemaining, chatId, text } }];\n"
      },

    {
      "parameters": {
        "jsCode": "function safeAll(nodeName) {\n  try { return $(nodeName).all().map(i => i.json); } catch (e) { return []; }\n}\nconst turns = $input.first().json;\nconst arr = Array.isArray(turns) ? turns : [];\nconst lines = [];\nconst participantEmails = new Set();\nfor (const turn of arr) {\n  const p = turn.participant || {};\n  const text = (turn.words || []).map(w => w.text).join(' ').trim();\n  if (!text) continue;\n  lines.push(`${p.name || 'Unbekannt'}: ${text}`);\n  if (p.email && !p.is_host) participantEmails.add(p.email);\n}\nlet full = lines.join('\\n');\nif (full.length > 12000) full = full.slice(0, 12000) + '\\n[...gekuerzt...]';\nreturn [{ json: { transcriptText: full || '(kein Transkriptinhalt gefunden)', participantEmails: [...participantEmails] } }];"
      },

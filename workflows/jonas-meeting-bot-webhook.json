        "jsCode": "function safeGet(nodeName, path) {\n  try { const n = $(nodeName); if (n.first()) return path(n.first().json); } catch (e) { return undefined; }\n  return undefined;\n}\nconst notesText = $json.text || safeGet('Notizen Fehler (kein Transkript)', j => j.text) || 'Konnte keine Notizen erzeugen — leeres oder zu kurzes Transkript.';\nconst zuordnung = $('Bot-Zuordnung laden').first().json;\nconst participantEmails = safeGet('Transkript zu Text', j => j.participantEmails) || [];\nreturn [{ json: {\n  telegramText: `Meeting-Notizen — \"${zuordnung.event_title || 'Meeting'}\"\\n\\n${notesText}`,\n  hubspotNoteText: `Meeting-Notizen (automatisch von Jonas): \"${zuordnung.event_title || 'Meeting'}\"\\n\\n${notesText}`,\n  emailBody: notesText,\n  eventTitle: zuordnung.event_title || 'Meeting',\n  tenantId: zuordnung.tenant_id,\n  telegramChatId: zuordnung.telegram_chat_id,\n  participantEmails\n} }];"

    {
      "parameters": {
        "jsCode": "\nconst subject = $('Termine filtern (Pre-Brief)').item.json.subject;\nconst startRaw = $('Termine filtern (Pre-Brief)').item.json.startRaw;\nlet timeLabel = 'in Kuerze';\nif (startRaw) {\n  const d = new Date(startRaw.endsWith('Z') ? startRaw : startRaw + 'Z');\n  if (!isNaN(d.getTime())) {\n    const berlin = new Date(d.toLocaleString(\"en-US\", { timeZone: \"Europe/Berlin\" }));\n    const pad = (n) => String(n).padStart(2, '0');\n    timeLabel = `${pad(berlin.getHours())}:${pad(berlin.getMinutes())} Uhr`;\n  }\n}\nconst contactLabel = $json.contactLabel;\nconst contactLine = contactLabel ? `\\n👤 HubSpot-Kontakt: ${contactLabel}` : '';\nreturn [{ json: { reply: `📋 In ca. 1h: \"${subject}\" um ${timeLabel}${contactLine}` } }];\n"
      },

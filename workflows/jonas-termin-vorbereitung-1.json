    {
      "parameters": {
        "jsCode": "\nconst now = Date.now();\nconst events = $json.value || [];\nreturn events.map(e => ({\n  json: {\n    tenant_id: $('Loop Over Tenants (Pre-Brief)').first().json.tenant_id,\n    telegram_chat_id: $('Loop Over Tenants (Pre-Brief)').first().json.telegram_chat_id,\n    event_id: e.id,\n    subject: e.subject || 'Termin',\n    startRaw: e.start ? e.start.dateTime : null,\n    attendeeEmails: (e.attendees || []).map(a => a.emailAddress && a.emailAddress.address).filter(Boolean)\n  }\n}));\n"
      },

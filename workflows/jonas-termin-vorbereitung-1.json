      "parameters": {
        "jsCode": "\nconst results = ($json.results || []).filter(r => r && r.id);\nconst first = results[0];\nreturn [{ json: {\n  hasContact: !!first,\n  contactLabel: first ? `${first.properties.firstname || ''} ${first.properties.lastname || ''}`.trim() : null\n} }];\n"

    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.tenant_id, t.telegram_chat_id,\n       pgp_sym_decrypt(tc.access_token, '{{ $env.TENANT_TOKEN_SECRET }}') AS hubspot_token\nFROM tenants t\nJOIN tenant_credentials tc ON tc.tenant_id = t.tenant_id AND tc.provider = 'hubspot'\nWHERE t.status = 'active' AND t.telegram_chat_id IS NOT NULL",
        "options": {}
      },
      "id": "fa0a8263-7eb4-4466-aac1-382978625cfc",
      "name": "Verbundene Tenants laden",

      "parameters": {
        "jsCode": "const code = $json.query?.code;\nconst state = $json.query?.state; // state = tenant_id\nconst error = $json.query?.error;\n\nif (error) {\n  return [{ json: { success: false, error: error, errorDescription: $json.query?.error_description || '' } }];\n}\n\nif (!code || !state) {\n  return [{ json: { success: false, error: 'missing_params', errorDescription: 'Code oder State fehlt in der Callback-URL' } }];\n}\n\nreturn [{ json: { success: true, code, tenantId: state } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -64
      ],

    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tenant_credentials (tenant_id, provider, access_token, refresh_token, expires_at)\nVALUES (\n  '{{ $('Code und State extrahieren').first().json.tenantId.replace(/'/g, \"''\") }}',\n  'outlook',\n  pgp_sym_encrypt('{{ $json.access_token.replace(/'/g, \"''\") }}', '{{ $env.TENANT_TOKEN_SECRET }}'),\n  pgp_sym_encrypt('{{ $json.refresh_token.replace(/'/g, \"''\") }}', '{{ $env.TENANT_TOKEN_SECRET }}'),\n  NOW() + INTERVAL '{{ $json.expires_in }} seconds'\n)\nON CONFLICT (tenant_id, provider) DO UPDATE SET\n  access_token = EXCLUDED.access_token,\n  refresh_token = EXCLUDED.refresh_token,\n  expires_at = EXCLUDED.expires_at,\n  updated_at = NOW();",
        "options": {}
      },

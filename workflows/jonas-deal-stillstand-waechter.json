    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $json.hubspotToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  filterGroups: [{ filters: [\n    { propertyName: 'dealstage', operator: 'NOT_IN', values: ['closedwon', 'closedlost'] },\n    { propertyName: 'hs_lastmodifieddate', operator: 'LT', value: String($json.cutoffMillis) }\n  ] }],\n  properties: ['dealname', 'dealstage', 'hs_lastmodifieddate'],\n  limit: 100\n}) }}",
        "options": {}
      },
      "id": "32014dfa-0476-4395-a13b-3440b71c0e5e",
      "name": "HubSpot Deals suchen (Stillstand)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        240,
        192
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT deal_id FROM jonas_deal_stillstand_sent\nWHERE tenant_id = '{{ $('Tenant Loop').first().json.tenant_id.replace(/'/g, \"''\") }}'\n  AND sent_at > NOW() - INTERVAL '7 days';",
        "options": {}
      },
      "id": "af676b89-fce2-4ba5-841f-a40bd89ddbdb",
      "name": "Bereits gemeldet laden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        464,
        192
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const httpResult = $('HubSpot Deals suchen (Stillstand)').first().json;\nconst results = httpResult.results || [];\nconst alreadySent = new Set($('Bereits gemeldet laden').all().map(i => i.json.deal_id));\nconst tenant = $('Tenant Loop').first().json;\nconst now = Date.now();\n\nconst fresh = results.filter(d => d.id && !alreadySent.has(d.id));\n\nif (fresh.length === 0) {\n  return [{ json: { skip: true } }];\n}\n\nreturn fresh.map(d => {\n  const lastModified = d.properties?.hs_lastmodifieddate ? new Date(d.properties.hs_lastmodifieddate) : null;\n  const daysStale = lastModified ? Math.floor((now - lastModified.getTime()) / (24 * 3600 * 1000)) : null;\n  return {\n    json: {\n      skip: false,\n      dealId: d.id,\n      dealName: d.properties?.dealname || 'Unbenannt',\n      dealStage: d.properties?.dealstage || '',\n      daysStale,\n      tenantId: tenant.tenant_id,\n      telegramChatId: tenant.telegram_chat_id,\n      hubspotToken: tenant.hubspot_token\n    }\n  };\n});"
      },

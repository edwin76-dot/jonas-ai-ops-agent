      "id": "b15ebf86-8e57-449a-b1e3-ccf8645640c7",
      "name": "Draft generieren (Stillstand)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        2256,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const orig = $('Kontakt-Email zusammenfuehren (Stillstand)').item.json;\nconst raw = $json.text || '';\nlet draft = 'Kurzes Follow-up zu \"' + orig.dealName + '\" waere faellig.';\nlet noteText = 'Deal haengt seit ' + (orig.daysStale ?? '?') + ' Tagen ohne Bewegung.';\ntry {\n  const clean = raw.replace(/```json|```/g, '').trim();\n  const start = clean.indexOf('{');\n  const end = clean.lastIndexOf('}');\n  if (start !== -1 && end !== -1) {\n    const parsed = JSON.parse(clean.slice(start, end + 1));\n    if (parsed.draft) draft = parsed.draft;\n    if (parsed.note_text) noteText = parsed.note_text;\n  }\n} catch (e) { /* defensiv: Fallback-Texte oben bleiben stehen */ }\nreturn { json: { ...orig, draft, noteText } };"
      },

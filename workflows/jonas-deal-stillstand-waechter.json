      "name": "Draft parsen (Stillstand)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO jonas_pending_dealfollowup (tenant_id, deal_id, deal_name, contact_email, draft_text, note_text, expires_at)\nVALUES (\n  '{{ $json.tenantId.replace(/'/g, \"''\") }}',\n  '{{ $json.dealId.replace(/'/g, \"''\") }}',\n  '{{ $json.dealName.replace(/'/g, \"''\") }}',\n  {{ $json.contactEmail ? \"'\" + $json.contactEmail.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n  '{{ $json.draft.replace(/'/g, \"''\") }}',\n  '{{ $json.noteText.replace(/'/g, \"''\") }}',\n  NOW() + INTERVAL '3 days'\n)\nRETURNING id;",
        "options": {}
      },

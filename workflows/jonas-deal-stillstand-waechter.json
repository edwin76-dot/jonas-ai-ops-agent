          "value": {
            "systemPrompt": "={{ \"Du bist ein erfahrener Vertriebsassistent fuer einen Immobilienmakler. \" +\n\"Ein CRM-Deal haengt seit laengerem ohne Fortschritt fest. Schreibe EIN kurzes, freundliches Follow-up und EINE knappe interne CRM-Notiz dazu. \" +\n\"Antworte AUSSCHLIESSLICH mit einem gueltigen JSON-Objekt, keine Code-Fences, keine Erklaerung. \" +\n\"Format (exakt diese Keys): \" + '{\"draft\":\"Follow-up-Mailtext auf Deutsch, kurz und konkret, mit Anrede und Grussformel\",\"note_text\":\"1 Satz interne Notiz fuers CRM\"}' }}",
            "userMessage": "={{ \"Deal: \" + $json.dealName + \"\\nAktuelle Stage: \" + $json.dealStage + \"\\n\" +\n\"Haengt seit \" + ($json.daysStale ?? 'unbekannt') + \" Tagen ohne Bewegung fest.\\n\" +\n\"Ansprechpartner: \" + ($json.contactName || 'unbekannt') + \"\\n\" +\n\"Bitte kurzes Follow-up + interne Notiz vorschlagen.\" }}",
            "maxTokens": "300"
          },

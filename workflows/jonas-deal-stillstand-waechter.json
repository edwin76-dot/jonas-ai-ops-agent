        "text": "={{ \"Deal \\\"\" + $('Draft parsen (Stillstand)').item.json.dealName + \"\\\" haengt seit \" + \n($('Draft parsen (Stillstand)').item.json.daysStale ?? '?') + \" Tagen in Stufe \\\"\" + \n$('Draft parsen (Stillstand)').item.json.dealStage + \"\\\" ohne Bewegung.\\n\\nVorschlag:\\n\" + \n$('Draft parsen (Stillstand)').item.json.draft + \n\"\\n\\nMail-Entwurf + HubSpot-Notiz anlegen? (ja/nein)\" }}",

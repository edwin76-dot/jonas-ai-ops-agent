    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalisieren (Mistral)\nif ($json.error) {\n  return { json: { text: '', error: $json.error?.message || 'LLM-Call fehlgeschlagen' } };\n}\nconst text = $json.choices?.[0]?.message?.content || '';\nreturn { json: { text } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        1680
      ],
      "id": "ea9609de-c7a8-45e1-a6c3-2f3dc11d1769",
      "name": "Normalisieren (Mistral)"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const trigger = $('When Executed by Another Workflow').item.json;\nconst config = $json.config;\nconst maxTokens = Number(trigger.maxTokens) || 400;\n\n\n\nlet imagesBase64 = trigger.imagesBase64;\nif (typeof imagesBase64 === 'string') {\n  try { imagesBase64 = JSON.parse(imagesBase64); } catch (e) { imagesBase64 = null; }\n}\n\nlet userContent;\nif (Array.isArray(imagesBase64) && imagesBase64.length > 0) {\n  // NEU: Mehrbild-Support (Media-Group/Album) -- ein Bild-Block pro Foto,\n  // Reihenfolge wie im Array, Text-Block ans Ende. Bestehende Single-Image-\n  // Aufrufe (imageBase64 singular) bleiben unveraendert im else-Zweig.\n  userContent = imagesBase64.map(img => ({\n    type: \"image\",\n    source: {\n      type: \"base64\",\n      media_type: img.mediaType || \"image/jpeg\",\n      data: img.data\n    }\n  }));\n  userContent.push({ type: \"text\", text: trigger.userMessage });\n} else if (trigger.imageBase64) {\n  userContent = [\n    {\n      type: \"image\",\n      source: {\n        type: \"base64\",\n        media_type: trigger.imageMediaType || \"image/jpeg\",\n        data: trigger.imageBase64\n      }\n    },\n    {\n      type: \"text\",\n      text: trigger.userMessage\n    }\n  ];\n} else {\n  userContent = trigger.userMessage;\n}\n\nconst anthropicBody = {\n  model: config.llm_model_anthropic,\n  max_tokens: maxTokens,\n  system: trigger.systemPrompt,\n  messages: [{ role: \"user\", content: userContent }]\n};\n\nreturn { json: { anthropicBody: JSON.stringify(anthropicBody), config } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        1680
      ],
      "id": "b2e047eb-2945-4a08-9ba2-43943fd01189",
      "name": "Anthropic Body bauen"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const trigger = $('When Executed by Another Workflow').item.json;\nconst config = $json.config;\nconst maxTokens = Number(trigger.maxTokens) || 600;\n\n// Gepinnt statt ueber system_config.llm_model_mistral ('latest') geladen --\n// verhindert, dass Mistral das Modell hinter dem Alias irgendwann austauscht\n// und Vision-Calls lautlos brechen.\nconst MISTRAL_MODEL = 'mistral-small-2506';\n\nlet imagesBase64 = trigger.imagesBase64;\nif (typeof imagesBase64 === 'string') {\n  try { imagesBase64 = JSON.parse(imagesBase64); } catch (e) { imagesBase64 = null; }\n}\n\nlet userContent;\nif (Array.isArray(imagesBase64) && imagesBase64.length > 0) {\n  // NEU: Mehrbild-Support, analog Anthropic Body bauen.\n  userContent = imagesBase64.map(img => ({\n    type: \"image_url\",\n    image_url: `data:${img.mediaType || 'image/jpeg'};base64,${img.data}`\n  }));\n  userContent.push({ type: \"text\", text: trigger.userMessage });\n} else if (trigger.imageBase64) {\n  userContent = [\n    { type: \"image_url\", image_url: `data:${trigger.imageMediaType || 'image/jpeg'};base64,${trigger.imageBase64}` },\n    { type: \"text\", text: trigger.userMessage }\n  ];\n} else {\n  userContent = trigger.userMessage;\n}\n\nconst mistralBody = {\n  model: MISTRAL_MODEL,\n  max_tokens: maxTokens,\n  messages: [\n    { role: \"system\", content: trigger.systemPrompt },\n    { role: \"user\", content: userContent }\n  ]\n};\n\nreturn { json: { mistralBody: JSON.stringify(mistralBody), config } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        1680
      ],

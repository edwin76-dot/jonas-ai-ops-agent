    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $json.hubspot_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  filterGroups: [{ filters: [\n    { propertyName: 'dealstage', operator: 'EQ', value: 'closedwon' },\n    { propertyName: 'closedate', operator: 'GTE', value: String(Date.now() - 90*24*3600*1000) }\n  ] }],\n  properties: ['dealname', 'amount', 'createdate', 'closedate'],\n  limit: 100\n}) }}",
        "options": {}
      },
      "id": "ee5a6ff7-83b1-42fd-bba2-8d10afa50390",
      "name": "HubSpot Closed-Won laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        16,
        192
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const httpResult = $json;\nconst deals = httpResult.results || [];\nconst tenant = $('Tenant Loop (Muster-Mining)').first().json;\n\nconst parsed = deals.map(d => {\n  const created = d.properties?.createdate ? new Date(d.properties.createdate).getTime() : null;\n  const closed = d.properties?.closedate ? new Date(d.properties.closedate).getTime() : null;\n  const cycleDays = (created && closed) ? Math.round((closed - created) / (24*3600*1000)) : null;\n  const amount = d.properties?.amount ? parseFloat(d.properties.amount) : null;\n  return {\n    name: d.properties?.dealname || 'Unbenannt',\n    amount,\n    cycleDays\n  };\n}).filter(d => d.cycleDays !== null);\n\nif (parsed.length < 3) {\n  return [{ json: { enoughData: false, dealCount: parsed.length } }];\n}\n\nconst cycleDaysList = parsed.map(d => d.cycleDays).sort((a,b) => a-b);\nconst avgCycle = Math.round(cycleDaysList.reduce((a,b) => a+b, 0) / cycleDaysList.length);\nconst medianCycle = cycleDaysList[Math.floor(cycleDaysList.length / 2)];\nconst amounts = parsed.filter(d => d.amount !== null).map(d => d.amount);\nconst avgAmount = amounts.length ? Math.round(amounts.reduce((a,b) => a+b, 0) / amounts.length) : null;\n\nconst topByAmount = parsed.slice().sort((a,b) => (b.amount||0) - (a.amount||0)).slice(0, 10);\nconst dealListText = topByAmount.map(d => `- ${d.name}: ${d.amount ?? '?'}€, ${d.cycleDays} Tage bis Abschluss`).join('\\n');\n\nreturn [{ json: {\n  enoughData: true,\n  dealCount: parsed.length,\n  avgCycle,\n  medianCycle,\n  avgAmount,\n  dealListText,\n  tenantId: tenant.tenant_id,\n  telegramChatId: tenant.telegram_chat_id\n} }];"
      },
      "id": "40d7dd84-b53e-495e-94ef-0c68572d494d",

    {
      "parameters": {
        "jsCode": "const leadId = $('Backfill Prompt bauen').first().json.lead_id;\nconst raw = $json.text || '';\nlet priority = null, followupDays = null;\ntry {\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start !== -1 && end !== -1) {\n    const parsed = JSON.parse(raw.slice(start, end + 1));\n    priority = ['A','B','C','D'].includes(parsed.priority) ? parsed.priority : null;\n    followupDays = typeof parsed.followup_days === 'number' ? parsed.followup_days : null;\n  }\n} catch (e) { /* priority bleibt null -> wird uebersprungen */ }\nreturn [{ json: { leadId, priority, followupDays } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        160

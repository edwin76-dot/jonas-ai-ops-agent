    {
      "parameters": {
        "jsCode": "const l = $json;\nconst systemPrompt = `Du schaetzt fuer einen bestehenden Lead/Kontakt anhand vorhandener Notizen nachtraeglich eine Prioritaet und ein Follow-up-Zeitfenster. Kein Bild verfuegbar, nur Text -- schaetze konservativ, bei Unklarheit lieber C statt A/B.\\n\\nKontakt: ${l.name}${l.company ? ' (' + l.company + ')' : ''}\\nNotizen: ${l.notes}\\n\\nPrioritaet A/B/C/D:\\n- A = hoher strategischer Hebel, schnell und aktiv, 1-3 Tage\\n- B = solider relevanter Kontakt, 3-10 Tage\\n- C = unklar oder spaeter relevant, 2-6 Wochen (14-42 Tage)\\n- D = derzeit keine Prioritaet, kein aktiver Follow-up\\n\\nAntworte NUR mit einem einzeiligen JSON-Objekt, keine Erklaerung drumherum: {\"priority\":\"A/B/C/D\",\"followup_days\":Zahl in Tagen passend zur Prioritaet, bei D immer null}`;\nreturn [{ json: { systemPrompt, tenant_id: l.tenant_id, lead_id: l.id } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

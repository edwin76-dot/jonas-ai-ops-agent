    },
    {
      "parameters": {
        "jsCode": "function slugify(s) {\n  return String(s).toLowerCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-+|-+$/g, '')\n    .slice(0, 40);\n}\nfunction randomToken(len) {\n  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';\n  let out = '';\n  for (let i = 0; i < len; i++) out += chars[Math.floor(Math.random() * chars.length)];\n  return out;\n}\nconst name = $json['Name'] || '';\nconst email = $json['E-Mail'] || '';\nreturn [{ json: {\n  tenantId: `${slugify(name) || 'kunde'}-${randomToken(4).toLowerCase()}`,\n  signupToken: randomToken(24),\n  email\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "23eae956-f91f-43f9-8e13-bc925d8b3cdb",
      "name": "Signup-Daten vorbereiten"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tenants (tenant_id, email, status, signup_token)\nVALUES (\n  '{{ $json.tenantId.replace(/'/g, \"''\") }}',\n  '{{ $json.email.replace(/'/g, \"''\") }}',\n  'pending',\n  '{{ $json.signupToken.replace(/'/g, \"''\") }}'\n)\nRETURNING tenant_id, signup_token;",
        "options": {}
      },

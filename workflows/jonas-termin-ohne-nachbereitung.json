      "typeVersion": 4.4,
      "position": [
        240,
        272
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const events = $json.value || [];\nconst cutoff = Date.now() - 3 * 3600 * 1000;\nconst tenant = $('Loop Over Tenants (Nachbereitung Check)').first().json;\nreturn events\n  .filter(e => (e.attendees || []).length > 0)\n  .filter(e => e.end && e.end.dateTime && new Date(e.end.dateTime + 'Z').getTime() < cutoff)\n  .map(e => ({\n    json: {\n      tenant_id: tenant.tenant_id,\n      telegram_chat_id: tenant.telegram_chat_id,\n      event_id: e.id,\n      subject: e.subject || 'Termin',\n      endRaw: e.end.dateTime,\n      attendeeEmails: (e.attendees || []).map(a => a.emailAddress && a.emailAddress.address).filter(Boolean)\n    }\n  }))\n  .filter(e => e.attendeeEmails.length > 0);"
      },

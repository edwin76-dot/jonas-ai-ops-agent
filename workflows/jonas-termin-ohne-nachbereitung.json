        "url": "={{ \"https://graph.microsoft.com/v1.0/me/calendarView?startDateTime=\" + new Date(Date.now() - 72*3600*1000).toISOString() + \"&endDateTime=\" + new Date(Date.now() - 3*3600*1000).toISOString() + \"&$select=id,subject,start,end,attendees\" }}",

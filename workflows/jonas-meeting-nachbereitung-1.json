      "parameters": {
        "jsCode": "\n// Nur Meetings deren Ende bereits vergangen ist und die noch nicht verarbeitet wurden.\n// Verarbeitet-Check erfolgt separat gegen jonas_processed_meetings (naechster SQL-Schritt),\n// hier nur strukturelle Filterung + Aufteilung Teams vs. Nicht-Teams.\nconst now = Date.now();\nconst events = ($json.value || []).filter(e => {\n  const end = e.end && e.end.dateTime ? new Date(e.end.dateTime + 'Z').getTime() : null;\n  return end && end < now;\n});\nreturn events.map(e => ({\n  json: {\n    tenant_id: $('Loop Over Tenants (Meeting)').first().json.tenant_id,\n    telegram_chat_id: $('Loop Over Tenants (Meeting)').first().json.telegram_chat_id,\n    event_id: e.id,\n    subject: e.subject || 'Meeting',\n    isTeams: e.isOnlineMeeting === true && e.onlineMeetingProvider === 'teamsForBusiness',\n    joinUrl: e.onlineMeeting ? e.onlineMeeting.joinUrl : null,\n    attendeeCount: (e.attendees || []).length,\n    attendeeEmails: (e.attendees || []).map(a => a.emailAddress && a.emailAddress.address).filter(Boolean)\n  }\n}));\n"

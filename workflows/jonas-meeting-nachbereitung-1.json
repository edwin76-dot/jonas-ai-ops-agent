    {
      "parameters": {
        "jsCode": "\n// Sehr einfacher VTT-Parser: entfernt Timestamps/Cue-Nummern, behaelt Sprecher+Text.\n// UNGETESTET gegen echte Graph-Transcript-VTT-Ausgabe -- vor Live-Schaltung mit\n// einem echten Transcript-Export verifizieren (Format kann <v Sprecher>Text</v> Tags enthalten).\nconst raw = typeof $json.data === 'string' ? $json.data : ($json.body || '');\nconst lines = raw.split('\\n');\nconst textLines = [];\nfor (const line of lines) {\n  const t = line.trim();\n  if (!t || t === 'WEBVTT') continue;\n  if (/^\\d+$/.test(t)) continue;\n  if (/-->/.test(t)) continue;\n  textLines.push(t.replace(/<\\/?v[^>]*>/g, ''));\n}\nreturn [{ json: { transcriptText: textLines.join('\\n').slice(0, 15000) } }];\n"
      },

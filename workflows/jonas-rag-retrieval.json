            "version": 3
          },
          "conditions": [
            {
              "id": "ab2742e1-3baa-422d-b33d-d02d3358c762",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",

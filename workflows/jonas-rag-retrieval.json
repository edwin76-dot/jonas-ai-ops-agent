      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const trig = $('Execute Workflow Trigger').first().json;\nconst vec = $json.data?.[0]?.embedding || null;\nif (!vec) {\n  return [{ json: { ok: false, contextText: '', error: $json.error?.message || 'keine Embedding-Daten in Antwort' } }];\n}\nreturn [{ json: {\n  ok: true,\n  embeddingLiteral: '[' + vec.join(',') + ']',\n  tenantId: trig.tenantId || null,\n  topK: Number(trig.topK) || 3\n} }];"
      },
      "id": "8b8b5599-2930-438a-a95a-ddf3fa65ad5c",
      "name": "Query-Embedding aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        112
      ]
    },
    {
      "parameters": {

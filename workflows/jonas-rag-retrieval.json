      "id": "4c803e8d-b79d-4c8a-9a9d-2ba81f539ba3",
      "name": "Embedding OK? (Retrieval)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -224,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT content, source_name\nFROM jonas_knowledge_chunks\nWHERE tenant_id IS NULL {{ $json.tenantId ? \"OR tenant_id = '\" + $json.tenantId.replace(/'/g, \"''\") + \"'\" : '' }}\nORDER BY embedding <=> '{{ $json.embeddingLiteral }}'::vector\nLIMIT {{ $json.topK }};",
        "options": {}
      },
      "id": "c5e2090f-87fb-40e1-b69d-91eb240954bb",
      "name": "Aehnlichste Chunks laden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst valid = rows.filter(r => r && r.content);\nif (valid.length === 0) {\n  return [{ json: { contextText: '' } }];\n}\nconst contextText = valid.map(r => `[${r.source_name}]\\n${r.content}`).join('\\n\\n');\nreturn [{ json: { contextText } }];"
      },

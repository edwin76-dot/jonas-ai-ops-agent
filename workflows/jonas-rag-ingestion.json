    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO jonas_knowledge_chunks (tenant_id, source_name, chunk_index, content, embedding)\nVALUES (\n  {{ $json.tenantId ? \"'\" + $json.tenantId.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n  '{{ $json.sourceName.replace(/'/g, \"''\") }}',\n  {{ $json.chunkIndex }},\n  '{{ $json.content.replace(/'/g, \"''\") }}',\n  '{{ $json.embeddingLiteral }}'::vector\n)\nON CONFLICT (source_name, chunk_index) DO UPDATE SET\n  content = EXCLUDED.content,\n  embedding = EXCLUDED.embedding,\n  tenant_id = EXCLUDED.tenant_id;",
        "options": {}

      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Mistral API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const orig = $('In Chunks teilen').item.json;\nconst vec = $json.data?.[0]?.embedding || null;\nif (!vec) {\n  return { json: { ...orig, embeddingLiteral: null, embedError: $json.error?.message || 'keine Embedding-Daten in Antwort' } };\n}\nconst embeddingLiteral = '[' + vec.join(',') + ']';\nreturn { json: { ...orig, embeddingLiteral } };"
      },

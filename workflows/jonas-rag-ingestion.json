      "id": "153e365a-5668-41de-93b5-e8f18ef28091",
      "name": "Quelltext (Platzhalter - vor Lauf befuellen)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1104,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\nconst text = (input.fullText || '').trim();\nif (!text) {\n  throw new Error('Kein Quelltext gesetzt - \"Quelltext (Platzhalter)\"-Node vor dem Lauf befuellen (fullText ist leer).');\n}\nif (!input.sourceName || input.sourceName === 'TODO-quelle-benennen') {\n  throw new Error('sourceName nicht gesetzt - bitte im \"Quelltext\"-Node einen echten Namen vergeben.');\n}\n\nconst CHUNK_SIZE = 800;\nconst paragraphs = text.split(/\\n\\s*\\n/).map(p => p.trim()).filter(Boolean);\nconst chunks = [];\nlet current = '';\nfor (const p of paragraphs) {\n  if ((current + '\\n\\n' + p).length > CHUNK_SIZE && current) {\n    chunks.push(current.trim());\n    current = p;\n  } else {\n    current = current ? current + '\\n\\n' + p : p;\n  }\n}\nif (current.trim()) chunks.push(current.trim());\n\nreturn chunks.map((c, i) => ({ json: {\n  sourceName: input.sourceName,\n  tenantId: input.tenantId || null,\n  chunkIndex: i,\n  content: c\n} }));"
      },
      "id": "24a314d9-352f-4830-89af-3cc20303083a",
      "name": "In Chunks teilen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,

      "id": "dd908cc7-8e08-4af4-bf35-7d5912348ba2",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        1536,
        2336
      ]
    },
    {
      "parameters": {
        "jsCode": "// Query-Param-Token statt Header -- vermeidet CORS-Preflight (OPTIONS)\n// beim Fetch von der Dashboard-Seite, die auf einer anderen Domain liegt.\n// Erwartet ?token=... in der Webhook-URL, verglichen gegen env OPS_DASHBOARD_TOKEN.\nconst token = $('Webhook').first().json.query?.token || '';\nconst expected = $env.OPS_DASHBOARD_TOKEN || '';\nconst authorized = expected.length > 0 && token === expected;\nreturn [{ json: { authorized } }];"
      },
      "id": "766a3faa-6db0-445f-a0a9-b3a6464f782c",
      "name": "Auth Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        2336
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "auth-check",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "71e5936f-3560-4023-9cc0-0108165094b5",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1984,
        2336
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'unauthorized' }) }}",
        "options": {
          "responseCode": 403,
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "1017384e-d4b7-48c0-b288-28a66b265b08",
      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2208,
        2432
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  count(*) FILTER (WHERE answered_at IS NULL) AS offene_anfragen,\n  round(percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) FILTER (WHERE answered_at IS NOT NULL)) AS latenz_median_ms,\n  count(*) AS anfragen_24h\nFROM jonas_request_log\nWHERE received_at > now() - interval '24 hours';",
        "options": {}
      },
      "id": "b6cd76be-f31b-4870-bd52-1bf5b94c0760",
      "name": "PG Zustellung",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2208,
        2240
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT tenant_id, update_id, received_at\nFROM jonas_request_log\nWHERE answered_at IS NULL AND received_at > now() - interval '24 hours'\nORDER BY received_at\nLIMIT 20;",
        "options": {}
      },
      "id": "4aae97ad-ac6d-48f9-9137-b555c7076bbd",
      "name": "PG Offene Liste",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2432,
        2240
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  t.tenant_id,\n  t.status,\n  t.plan,\n  t.channel,\n  (SELECT max(received_at) FROM jonas_request_log r WHERE r.tenant_id = t.tenant_id) AS zuletzt_aktiv,\n  (SELECT count(*) FROM jonas_request_log r WHERE r.tenant_id = t.tenant_id AND r.received_at > now() - interval '7 days') AS anfragen_7d,\n  (SELECT expires_at FROM tenant_credentials c WHERE c.tenant_id = t.tenant_id AND c.provider = 'outlook') AS outlook_token_bis,\n  EXISTS(SELECT 1 FROM tenant_credentials c WHERE c.tenant_id = t.tenant_id AND c.provider = 'hubspot') AS hubspot_verbunden,\n  (SELECT max(sent_date) FROM jonas_briefing_sent b WHERE b.tenant_id = t.tenant_id) AS letztes_briefing\nFROM tenants t\nORDER BY t.status, t.tenant_id;",
        "options": {}
      },
      "id": "959d1e2d-0f41-4165-b55d-1fdfefee1385",
      "name": "PG Kundentabelle",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2656,
        2240
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT tenant_id, status, created_at\nFROM tenants\nWHERE status = 'pending' AND created_at < now() - interval '24 hours'\nORDER BY created_at;",
        "options": {}
      },
      "id": "7adfb5c1-ab8d-4b89-b13a-d944099095bc",
      "name": "PG Trichter",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2880,
        2240
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT tenant_id,\n       round(100.0 * count(*) FILTER (WHERE intent = 'chat') / NULLIF(count(*),0), 1) AS chat_pct,\n       count(*) AS anfragen_7d\nFROM jonas_request_log\nWHERE received_at > now() - interval '7 days'\nGROUP BY tenant_id\nORDER BY chat_pct DESC NULLS LAST;",
        "options": {}
      },
      "id": "526a0428-08ec-4553-832e-de7047744041",
      "name": "PG Qualitaet",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3104,
        2240
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  max(received_at) AS letzte_anfrage,\n  count(*) FILTER (WHERE received_at > now() - interval '1 hour') AS anfragen_letzte_stunde\nFROM jonas_request_log;",
        "options": {}
      },
      "id": "cf31e480-6a84-4947-b3e0-6351db518a91",
      "name": "PG Aktivitaet",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3328,
        2240
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Baut das finale Dashboard-JSON aus allen Postgres-Nodes zusammen.\n// Explizite Node-Referenzen + safeGet()-Pattern (Projekt-Standard,\n// siehe technische Doku 26.1) -- robust falls eine Query 0 Zeilen liefert.\n\nfunction safeGet(nodeName) {\n  try {\n    return $(nodeName).all().map(i => i.json);\n  } catch (e) {\n    return [];\n  }\n}\n\nconst zustellung = safeGet('PG Zustellung')[0] || {};\nconst aktivitaet = safeGet('PG Aktivitaet')[0] || {};\n\nreturn [{\n  json: {\n    generated_at: new Date().toISOString(),\n    zustellung: {\n      offene_anfragen: zustellung.offene_anfragen ?? null,\n      latenz_median_ms: zustellung.latenz_median_ms ?? null,\n      anfragen_24h: zustellung.anfragen_24h ?? null,\n      offene_liste: safeGet('PG Offene Liste')\n    },\n    aktivitaet: {\n      letzte_anfrage: aktivitaet.letzte_anfrage ?? null,\n      anfragen_letzte_stunde: aktivitaet.anfragen_letzte_stunde ?? null\n    },\n    kunden: safeGet('PG Kundentabelle'),\n    trichter: safeGet('PG Trichter'),\n    qualitaet: safeGet('PG Qualitaet')\n  }\n}];"
      },
      "id": "f34237c0-ce8a-43fa-8df9-b924341e5411",
      "name": "Dashboard JSON zusammenbauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3552,
        2240
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "0bb88e26-0be3-4c58-8aa9-e3185e0120ae",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        3776,
        2240
      ]
    },
    {
      "parameters": {
        "path": "ops-ui",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "60183586-b5ce-4faf-9042-ec0f1db43941",
      "name": "UI Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        1536,
        2656
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<title>Jonas Ops</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n\n  :root{\n    color-scheme: dark;\n    --bg:#0e1417;\n    --surface:#151d22;\n    --surface-2:#1c262c;\n    --border:#293338;\n    --text:#e7edf0;\n    --text-dim:#8b9aa2;\n    --text-faint:#5c6a71;\n    --accent:#5fb3c9;\n    --accent-dim:#3a6d7a;\n    --ok:#4fae7c;\n    --ok-bg:rgba(79,174,124,.13);\n    --warn:#d7a23f;\n    --warn-bg:rgba(215,162,63,.14);\n    --crit:#dd6461;\n    --crit-bg:rgba(221,100,97,.14);\n    --font-body:'Public Sans',system-ui,-apple-system,sans-serif;\n    --font-mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;\n  }\n\n  *{box-sizing:border-box;}\n  html,body{background:var(--bg);}\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:var(--font-body);\n    line-height:1.45;\n    -webkit-font-smoothing:antialiased;\n    margin:0;\n  }\n  h1,h2,h3{text-wrap:balance;margin:0;}\n  ::selection{background:var(--accent-dim);color:#fff;}\n  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;}\n\n  .wrap{max-width:1080px;margin:0 auto;padding:20px 18px 64px;}\n\n  /* ---------- header ---------- */\n  header{\n    display:flex;align-items:flex-start;justify-content:space-between;gap:16px;\n    padding-bottom:18px;margin-bottom:22px;border-bottom:1px solid var(--border);\n  }\n  .brand{display:flex;flex-direction:column;gap:4px;}\n  .brand .eyebrow{\n    font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;\n    color:var(--text-faint);\n  }\n  .brand h1{font-size:22px;font-weight:700;letter-spacing:-.01em;}\n  .head-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end;}\n  .updated{font-family:var(--font-mono);font-size:12px;color:var(--text-faint);white-space:nowrap;}\n\n  .btn{\n    font-family:var(--font-body);font-size:13px;font-weight:600;color:var(--text);\n    background:var(--surface-2);border:1px solid var(--border);border-radius:7px;\n    padding:7px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;\n    transition:border-color .15s, background .15s;\n  }\n  .btn:hover{border-color:var(--accent-dim);background:#212c32;}\n  .btn:active{transform:translateY(1px);}\n  .btn.icon{padding:7px 9px;}\n\n  .pill{\n    font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.03em;\n    padding:3px 9px;border-radius:99px;display:inline-flex;align-items:center;gap:5px;\n    white-space:nowrap;\n  }\n  .pill.ok{background:var(--ok-bg);color:var(--ok);}\n  .pill.warn{background:var(--warn-bg);color:var(--warn);}\n  .pill.crit{background:var(--crit-bg);color:var(--crit);}\n  .pill.neutral{background:var(--surface-2);color:var(--text-dim);border:1px solid var(--border);}\n  .pill .dot{width:6px;height:6px;border-radius:50%;background:currentColor;}\n\n  /* ---------- layout ---------- */\n  .grid{display:grid;gap:16px;grid-template-columns:repeat(12,1fr);}\n  .card{\n    background:var(--surface);border:1px solid var(--border);border-radius:12px;\n    padding:18px 18px 16px;display:flex;flex-direction:column;gap:12px;\n  }\n  .card h2{\n    font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text-dim);\n    display:flex;align-items:center;justify-content:space-between;\n  }\n  .card h2 small{font-family:var(--font-mono);font-weight:500;color:var(--text-faint);text-transform:none;letter-spacing:0;}\n\n  .c-activity{grid-column:span 12;}\n  .c-delivery{grid-column:span 5;}\n  .c-quality{grid-column:span 7;}\n  .c-customers{grid-column:span 12;}\n  .c-funnel{grid-column:span 12;}\n  @media (max-width:820px){\n    .c-delivery,.c-quality{grid-column:span 12;}\n  }\n\n  /* ---------- activity strip ---------- */\n  .activity-row{display:flex;gap:28px;flex-wrap:wrap;align-items:baseline;}\n  .stat{display:flex;flex-direction:column;gap:2px;}\n  .stat .num{font-family:var(--font-mono);font-size:26px;font-weight:700;font-variant-numeric:tabular-nums;}\n  .stat .label{font-size:12px;color:var(--text-dim);}\n\n  /* ---------- delivery card ---------- */\n  .big-stat{display:flex;align-items:baseline;gap:10px;}\n  .big-stat .num{font-family:var(--font-mono);font-size:42px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1;}\n  .big-stat .num.ok{color:var(--ok);}\n  .big-stat .num.crit{color:var(--crit);}\n  .big-stat .sub{font-size:13px;color:var(--text-dim);}\n  .metric-row{display:flex;gap:22px;padding-top:2px;border-top:1px solid var(--border);margin-top:2px;}\n  .metric-row .stat .num{font-size:18px;}\n\n  .stuck-list{display:flex;flex-direction:column;gap:6px;margin-top:2px;}\n  .stuck-item{\n    display:flex;justify-content:space-between;gap:10px;font-size:13px;\n    background:var(--crit-bg);border:1px solid rgba(221,100,97,.3);border-radius:8px;padding:8px 10px;\n  }\n  .stuck-item .who{font-weight:600;}\n  .stuck-item .since{font-family:var(--font-mono);color:var(--text-dim);font-size:12px;white-space:nowrap;}\n  .empty-note{\n    font-size:13px;color:var(--text-dim);background:var(--surface-2);border:1px solid var(--border);\n    border-radius:8px;padding:9px 11px;\n  }\n\n  /* ---------- quality bars ---------- */\n  .qrow{display:grid;grid-template-columns:110px 1fr 76px;align-items:center;gap:10px;}\n  .qrow .name{font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}\n  .qbar{height:7px;border-radius:99px;background:var(--surface-2);overflow:hidden;}\n  .qbar > span{display:block;height:100%;background:var(--accent);border-radius:99px;}\n  .qrow .val{font-family:var(--font-mono);font-size:12px;color:var(--text-dim);text-align:right;font-variant-numeric:tabular-nums;}\n\n  /* ---------- table ---------- */\n  .table-scroll{overflow-x:auto;}\n  table{width:100%;border-collapse:collapse;font-size:13px;min-width:640px;}\n  th{\n    text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-faint);\n    font-weight:600;padding:0 10px 8px;border-bottom:1px solid var(--border);white-space:nowrap;\n  }\n  td{padding:10px 10px;border-bottom:1px solid var(--border);vertical-align:middle;white-space:nowrap;}\n  tr:last-child td{border-bottom:none;}\n  td.tenant{font-weight:600;font-family:var(--font-mono);font-size:12.5px;}\n  td.mono{font-family:var(--font-mono);font-size:12px;color:var(--text-dim);font-variant-numeric:tabular-nums;}\n\n  /* ---------- funnel ---------- */\n  .funnel-item{\n    display:flex;justify-content:space-between;gap:10px;font-size:13px;\n    background:var(--warn-bg);border:1px solid rgba(215,162,63,.3);border-radius:8px;padding:8px 10px;\n  }\n\n  /* ---------- settings / status ---------- */\n  .status-banner{\n    display:none;align-items:center;gap:10px;font-size:13px;padding:11px 14px;border-radius:9px;\n    background:var(--crit-bg);border:1px solid rgba(221,100,97,.35);color:var(--text);margin-bottom:18px;\n  }\n  .status-banner code{font-family:var(--font-mono);background:var(--surface-2);padding:1px 5px;border-radius:4px;font-size:12px;}\n\n  dialog{\n    background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:12px;\n    padding:20px;width:min(400px,92vw);\n  }\n  dialog::backdrop{background:rgba(0,0,0,.55);}\n  dialog h3{font-size:15px;margin-bottom:14px;}\n  .field{display:flex;flex-direction:column;gap:5px;margin-bottom:14px;}\n  .field label{font-size:12px;color:var(--text-dim);}\n  .field input{\n    font-family:var(--font-mono);font-size:13px;background:var(--surface-2);color:var(--text);\n    border:1px solid var(--border);border-radius:7px;padding:8px 10px;\n    width:100%;\n  }\n  .field input:focus-visible{outline:2px solid var(--accent);outline-offset:1px;}\n  .dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:4px;}\n\n  .skeleton{color:var(--text-faint);font-size:13px;font-style:italic;}\n  footer{margin-top:30px;font-size:11px;color:var(--text-faint);text-align:center;font-family:var(--font-mono);}\n</style>\n</head>\n<body>\n\n<div class=\"wrap\">\n  <header>\n    <div class=\"brand\">\n      <span class=\"eyebrow\">ESWflow &middot; Live</span>\n      <h1>Jonas Ops</h1>\n    </div>\n    <div class=\"head-meta\">\n      <span class=\"updated\" id=\"updated\">&mdash;</span>\n      <span class=\"pill neutral\" id=\"overallPill\"><span class=\"dot\"></span>lädt&hellip;</span>\n      <button class=\"btn icon\" id=\"refreshBtn\" title=\"Jetzt aktualisieren\" aria-label=\"Jetzt aktualisieren\">&#8635;</button>\n      <button class=\"btn icon\" id=\"settingsBtn\" title=\"Einstellungen\" aria-label=\"Einstellungen\">&#9881;</button>\n    </div>\n  </header>\n\n  <div class=\"status-banner\" id=\"statusBanner\"></div>\n\n  <div class=\"grid\" id=\"dash\" style=\"display:none;\">\n    <section class=\"card c-activity\">\n      <h2>Aktivität</h2>\n      <div class=\"activity-row\">\n        <div class=\"stat\">\n          <span class=\"num\" id=\"lastSeen\">&mdash;</span>\n          <span class=\"label\">seit letzter Anfrage</span>\n        </div>\n        <div class=\"stat\">\n          <span class=\"num\" id=\"reqLastHour\">&mdash;</span>\n          <span class=\"label\">Anfragen, letzte Stunde</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"card c-delivery\">\n      <h2>Zustellung <small>24h</small></h2>\n      <div class=\"big-stat\">\n        <span class=\"num\" id=\"openCount\">&mdash;</span>\n        <span class=\"sub\">offene Anfragen</span>\n      </div>\n      <div class=\"metric-row\">\n        <div class=\"stat\"><span class=\"num\" id=\"latencyMed\">&mdash;</span><span class=\"label\">Latenz-Median</span></div>\n        <div class=\"stat\"><span class=\"num\" id=\"reqCount24h\">&mdash;</span><span class=\"label\">Anfragen 24h</span></div>\n      </div>\n      <div class=\"stuck-list\" id=\"stuckList\"></div>\n    </section>\n\n    <section class=\"card c-quality\">\n      <h2>Qualität <small>chat-Anteil, 7 Tage</small></h2>\n      <div id=\"qualityRows\" style=\"display:flex;flex-direction:column;gap:10px;\"></div>\n    </section>\n\n    <section class=\"card c-customers\">\n      <h2>Kunden</h2>\n      <div class=\"table-scroll\">\n        <table>\n          <thead>\n            <tr>\n              <th>Tenant</th><th>Status</th><th>Plan</th><th>Channel</th>\n              <th>Zuletzt aktiv</th><th>Anfragen 7d</th><th>Outlook</th><th>HubSpot</th><th>Briefing</th>\n            </tr>\n          </thead>\n          <tbody id=\"customerRows\"></tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"card c-funnel\">\n      <h2>Trichter <small>bezahlt, nie verbunden &gt; 24h</small></h2>\n      <div id=\"funnelRows\" style=\"display:flex;flex-direction:column;gap:8px;\"></div>\n    </section>\n  </div>\n\n  <footer>jonas_request_log &middot; aktualisiert automatisch alle 60s</footer>\n</div>\n\n<dialog id=\"settingsDialog\">\n  <h3>Verbindung</h3>\n  <div class=\"field\">\n    <label for=\"urlInput\">Webhook-URL</label>\n    <input type=\"text\" id=\"urlInput\" placeholder=\"https://n8n.example.com/webhook/ops\" />\n  </div>\n  <div class=\"field\">\n    <label for=\"tokenInput\">Token</label>\n    <input type=\"text\" id=\"tokenInput\" placeholder=\"OPS_DASHBOARD_TOKEN\" autocomplete=\"off\" />\n  </div>\n  <div class=\"dialog-actions\">\n    <button class=\"btn\" id=\"cancelSettings\">Abbrechen</button>\n    <button class=\"btn\" id=\"saveSettings\" style=\"background:var(--accent-dim);border-color:var(--accent);\">Speichern</button>\n  </div>\n</dialog>\n\n<script>\n(function(){\n  'use strict';\n\n  var DEFAULT_URL = new URL('ops', window.location.href).href;\n  var store = { url: DEFAULT_URL, token: '' };\n  try {\n    var savedUrl = localStorage.getItem('jonas_ops_url');\n    var savedToken = localStorage.getItem('jonas_ops_token');\n    if (savedUrl) store.url = savedUrl;\n    if (savedToken) store.token = savedToken;\n  } catch (e) {}\n\n  var els = {\n    updated: document.getElementById('updated'),\n    overallPill: document.getElementById('overallPill'),\n    banner: document.getElementById('statusBanner'),\n    dash: document.getElementById('dash'),\n    refreshBtn: document.getElementById('refreshBtn'),\n    settingsBtn: document.getElementById('settingsBtn'),\n    dialog: document.getElementById('settingsDialog'),\n    urlInput: document.getElementById('urlInput'),\n    tokenInput: document.getElementById('tokenInput'),\n    saveSettings: document.getElementById('saveSettings'),\n    cancelSettings: document.getElementById('cancelSettings'),\n    lastSeen: document.getElementById('lastSeen'),\n    reqLastHour: document.getElementById('reqLastHour'),\n    openCount: document.getElementById('openCount'),\n    latencyMed: document.getElementById('latencyMed'),\n    reqCount24h: document.getElementById('reqCount24h'),\n    stuckList: document.getElementById('stuckList'),\n    qualityRows: document.getElementById('qualityRows'),\n    customerRows: document.getElementById('customerRows'),\n    funnelRows: document.getElementById('funnelRows')\n  };\n\n  function fmtRelative(iso) {\n    if (!iso) return 'nie';\n    var diffMs = Date.now() - new Date(iso).getTime();\n    var min = Math.round(diffMs / 60000);\n    if (min < 1) return 'gerade eben';\n    if (min < 60) return min + ' Min';\n    var h = Math.round(min / 60);\n    if (h < 24) return h + ' Std';\n    var d = Math.round(h / 24);\n    return d + ' Tag' + (d === 1 ? '' : 'e');\n  }\n\n  function fmtClock(iso) {\n    if (!iso) return '&mdash;';\n    var d = new Date(iso);\n    return d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });\n  }\n\n  function esc(s) {\n    return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c];\n    });\n  }\n\n  function setPill(el, level, text) {\n    el.className = 'pill ' + level;\n    el.innerHTML = '<span class=\"dot\"></span>' + esc(text);\n  }\n\n  function showError(msg) {\n    els.banner.style.display = 'flex';\n    els.banner.innerHTML = '&#9888;&#65039; ' + msg;\n    setPill(els.overallPill, 'crit', 'nicht erreichbar');\n  }\n\n  function hideError() {\n    els.banner.style.display = 'none';\n  }\n\n  function render(data) {\n    els.dash.style.display = 'grid';\n    hideError();\n\n    els.updated.textContent = 'aktualisiert ' + fmtClock(data.generated_at);\n\n    // Zahl kommt bewusst aus der Liste selbst (nicht aus einer separaten COUNT-Query) --\n    // sonst koennen beide durch Timing zwischen zwei parallelen Postgres-Queries auseinanderlaufen.\n    // Gefiltert auf update_id != null: n8n's Postgres-Node schickt bei 0 Treffern (mit\n    // \"Always Output Data\") ein leeres Platzhalter-Item statt eines leeren Arrays -- das\n    // wuerde sonst als \"1 offene Anfrage\" mitgezaehlt, obwohl gar keine echte Zeile da ist.\n    var stuckArr0 = ((data.zustellung && data.zustellung.offene_liste) || []).filter(function(r){ return r && r.update_id != null; });\n    var openN = stuckArr0.length;\n    if (openN > 0) setPill(els.overallPill, 'crit', openN + ' unbeantwortet');\n    else setPill(els.overallPill, 'ok', 'alles beantwortet');\n\n    var akt = data.aktivitaet || {};\n    els.lastSeen.textContent = fmtRelative(akt.letzte_anfrage);\n    els.reqLastHour.textContent = (akt.anfragen_letzte_stunde != null ? akt.anfragen_letzte_stunde : '0');\n\n    var z = data.zustellung || {};\n    els.openCount.textContent = openN;\n    els.openCount.className = 'num ' + (openN > 0 ? 'crit' : 'ok');\n    els.latencyMed.textContent = z.latenz_median_ms != null ? (Math.round(z.latenz_median_ms / 100) / 10) + 's' : '&mdash;';\n    els.reqCount24h.textContent = z.anfragen_24h != null ? z.anfragen_24h : '0';\n\n    var stuck = (z.offene_liste || []).filter(function(r){ return r && r.update_id != null; });\n    if (stuck.length === 0) {\n      els.stuckList.innerHTML = '<div class=\"empty-note\">Keine offenen Anfragen &mdash; alles beantwortet.</div>';\n    } else {\n      els.stuckList.innerHTML = stuck.map(function (r) {\n        return '<div class=\"stuck-item\"><span class=\"who\">' + esc(r.tenant_id) + '</span>' +\n          '<span class=\"since\">seit ' + fmtRelative(r.received_at) + '</span></div>';\n      }).join('');\n    }\n\n    var qual = (data.qualitaet || []).filter(function(r){ return r && r.tenant_id != null; });\n    if (qual.length === 0) {\n      els.qualityRows.innerHTML = '<div class=\"empty-note\">Noch keine Daten in den letzten 7 Tagen.</div>';\n    } else {\n      els.qualityRows.innerHTML = qual.map(function (r) {\n        var pct = r.chat_pct != null ? r.chat_pct : 0;\n        return '<div class=\"qrow\"><span class=\"name\">' + esc(r.tenant_id) + '</span>' +\n          '<div class=\"qbar\"><span style=\"width:' + Math.min(100, pct) + '%\"></span></div>' +\n          '<span class=\"val\">' + pct + '% &middot; ' + r.anfragen_7d + '</span></div>';\n      }).join('');\n    }\n\n    var kunden = (data.kunden || []).filter(function(k){ return k && k.tenant_id != null; });\n    els.customerRows.innerHTML = kunden.map(function (k) {\n      var statusLevel = k.status === 'active' ? 'ok' : (k.status === 'pending' ? 'warn' : 'neutral');\n      var channelLevel = k.channel === 'internal' ? 'neutral' : 'ok';\n      var outlookText = '&mdash;';\n      if (k.outlook_token_bis) {\n        var expired = new Date(k.outlook_token_bis).getTime() < Date.now();\n        outlookText = '<span class=\"pill ' + (expired ? 'crit' : 'ok') + '\">' + (expired ? 'abgelaufen' : 'gültig') + '</span>';\n      }\n      var hubspotText = k.hubspot_verbunden\n        ? '<span class=\"pill ok\">verbunden</span>'\n        : '<span class=\"pill neutral\">&mdash;</span>';\n      return '<tr>' +\n        '<td class=\"tenant\">' + esc(k.tenant_id) + '</td>' +\n        '<td><span class=\"pill ' + statusLevel + '\">' + esc(k.status || '&mdash;') + '</span></td>' +\n        '<td class=\"mono\">' + esc(k.plan || '&mdash;') + '</td>' +\n        '<td><span class=\"pill ' + channelLevel + '\">' + esc(k.channel || 'stable') + '</span></td>' +\n        '<td class=\"mono\">' + fmtRelative(k.zuletzt_aktiv) + '</td>' +\n        '<td class=\"mono\">' + (k.anfragen_7d != null ? k.anfragen_7d : 0) + '</td>' +\n        '<td>' + outlookText + '</td>' +\n        '<td>' + hubspotText + '</td>' +\n        '<td class=\"mono\">' + (k.letztes_briefing ? fmtRelative(k.letztes_briefing) : '&mdash;') + '</td>' +\n        '</tr>';\n    }).join('');\n\n    var funnel = (data.trichter || []).filter(function(f){ return f && f.tenant_id != null; });\n    if (funnel.length === 0) {\n      els.funnelRows.innerHTML = '<div class=\"empty-note\">Keine hängenden Signups.</div>';\n    } else {\n      els.funnelRows.innerHTML = funnel.map(function (f) {\n        return '<div class=\"funnel-item\"><span>' + esc(f.tenant_id) + '</span>' +\n          '<span class=\"mono\" style=\"font-family:var(--font-mono);color:var(--text-dim);\">seit ' + fmtRelative(f.created_at) + '</span></div>';\n      }).join('');\n    }\n  }\n\n  function load() {\n    if (!store.url || !store.token) {\n      showError('Noch keine Verbindung eingerichtet &mdash; auf &#9881; klicken und Webhook-URL + Token eintragen.');\n      return;\n    }\n    setPill(els.overallPill, 'neutral', 'lädt…');\n    var sep = store.url.indexOf('?') === -1 ? '?' : '&';\n    fetch(store.url + sep + 'token=' + encodeURIComponent(store.token))\n      .then(function (res) {\n        if (!res.ok) throw new Error('HTTP ' + res.status + (res.status === 403 ? ' — Token falsch?' : ''));\n        return res.json();\n      })\n      .then(function (data) {\n        if (data && data.error) throw new Error(data.error);\n        render(data);\n      })\n      .catch(function (err) {\n        showError('Konnte Daten nicht laden: <code>' + esc(err.message) + '</code>.');\n      });\n  }\n\n  els.refreshBtn.addEventListener('click', load);\n  els.settingsBtn.addEventListener('click', function () {\n    els.urlInput.value = store.url;\n    els.tokenInput.value = store.token;\n    els.dialog.showModal();\n  });\n  els.cancelSettings.addEventListener('click', function () { els.dialog.close(); });\n  els.saveSettings.addEventListener('click', function () {\n    store.url = els.urlInput.value.trim() || DEFAULT_URL;\n    store.token = els.tokenInput.value.trim();\n    try {\n      localStorage.setItem('jonas_ops_url', store.url);\n      localStorage.setItem('jonas_ops_token', store.token);\n    } catch (e) {}\n    els.dialog.close();\n    load();\n  });\n\n  load();\n  setInterval(load, 60000);\n})();\n</script>\n</body>\n</html>\n",

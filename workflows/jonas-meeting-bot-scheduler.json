        "url": "={{ \"https://graph.microsoft.com/v1.0/me/calendarView?startDateTime=\" + $now.toISO() + \"&endDateTime=\" + $now.plus({minutes:12}).toISO() + \"&$select=id,subject,start,end,onlineMeeting,location,body&$top=25\" }}",
        "sendHeaders": true,

      "name": "Kalenderdaten abrufen (Meeting Scan)",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const tenantId = $('Aktive Tenants laden').item.json.tenant_id;\nconst chatId = $('Aktive Tenants laden').item.json.telegram_chat_id;\nconst events = $input.first().json.value || [];\nif (events.length === 0) {\n  return [{ json: { tenant_id: tenantId, telegram_chat_id: chatId, no_events: true } }];\n}\nreturn events.map(e => ({ json: { ...e, tenant_id: tenantId, telegram_chat_id: chatId } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1872,
        1248
      ],
      "id": "5842172a-3544-4469-ad06-5622448eb64d",
      "name": "Events entpacken (Meeting Scan)",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "function extractLink(ev) {\n  if (ev.onlineMeeting && ev.onlineMeeting.joinUrl) return ev.onlineMeeting.joinUrl;\n  const text = ((ev.body && ev.body.content) || '') + ' ' + ((ev.location && ev.location.displayName) || '');\n  const m = text.match(/https:\\/\\/(?:[\\w.-]*zoom\\.us\\/j\\/[^\\s\"'<>]+|teams\\.microsoft\\.com\\/l\\/meetup-join\\/[^\\s\"'<>]+|meet\\.google\\.com\\/[a-z-]+)/i);\n  return m ? m[0] : null;\n}\nconst items = $input.all().map(i => i.json);\nconst withLinks = items\n  .filter(ev => !ev.no_events)\n  .map(ev => ({ ...ev, meeting_url: extractLink(ev) }))\n  .filter(ev => ev.meeting_url);\n\nif (withLinks.length === 0) {\n  const first = items[0] || {};\n  return [{ json: { tenant_id: first.tenant_id, telegram_chat_id: first.telegram_chat_id, meeting_url: null } }];\n}\nreturn withLinks.map(ev => ({ json: ev }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

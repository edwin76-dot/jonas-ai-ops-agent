      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO jonas_meeting_bots (tenant_id, event_id, event_title, meeting_url, telegram_chat_id, status)\nVALUES (\n  '{{ $json.tenant_id.replace(/'/g, \"''\") }}',\n  '{{ $json.id.replace(/'/g, \"''\") }}',\n  '{{ ($json.subject || \"\").replace(/'/g, \"''\") }}',\n  '{{ $json.meeting_url.replace(/'/g, \"''\") }}',\n  '{{ $json.telegram_chat_id.replace(/'/g, \"''\") }}',\n  'pending'\n)\nON CONFLICT (tenant_id, event_id) DO NOTHING\nRETURNING tenant_id, event_id, event_title, meeting_url, telegram_chat_id;",
        "options": {}

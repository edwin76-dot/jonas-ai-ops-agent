      "id": "5a1d7adf-cba4-4375-9672-f8afc64c1d81",
      "name": "Normalisieren (Mistral)"
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When Executed by Another Workflow').first().json;\nconst config = $('Config laden').first().json.config;\nconst maxTokens = Number(trigger.maxTokens) || 400;\n\n\n\nlet userContent;\nif (trigger.imageBase64) {\n  userContent = [\n    {\n      type: \"image\",\n      source: {\n        type: \"base64\",\n        media_type: trigger.imageMediaType || \"image/jpeg\",\n        data: trigger.imageBase64\n      }\n    },\n    {\n      type: \"text\",\n      text: trigger.userMessage\n    }\n  ];\n} else {\n  userContent = trigger.userMessage;\n}\n\nconst anthropicBody = {\n  model: config.llm_model_anthropic,\n  max_tokens: maxTokens,\n  system: trigger.systemPrompt,\n  messages: [{ role: \"user\", content: userContent }]\n};\n\nreturn [{ json: { anthropicBody: JSON.stringify(anthropicBody), config } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
        448
      ],
      "id": "03954730-eefe-4209-8308-a53a804a84b6",
      "name": "Anthropic Body bauen"
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When Executed by Another Workflow').first().json;\nconst config = $('Config laden').first().json.config;\nconst maxTokens = Number(trigger.maxTokens) || 600;\n\n// Gepinnt statt ueber system_config.llm_model_mistral ('latest') geladen --\n// verhindert, dass Mistral das Modell hinter dem Alias irgendwann austauscht\n// und Vision-Calls lautlos brechen.\nconst MISTRAL_MODEL = 'mistral-small-2506';\n\nlet userContent;\nif (trigger.imageBase64) {\n  userContent = [\n    { type: \"image_url\", image_url: `data:${trigger.imageMediaType || 'image/jpeg'};base64,${trigger.imageBase64}` },\n    { type: \"text\", text: trigger.userMessage }\n  ];\n} else {\n  userContent = trigger.userMessage;\n}\n\nconst mistralBody = {\n  model: MISTRAL_MODEL,\n  max_tokens: maxTokens,\n  messages: [\n    { role: \"system\", content: trigger.systemPrompt },\n    { role: \"user\", content: userContent }\n  ]\n};\n\nreturn [{ json: { mistralBody: JSON.stringify(mistralBody), config } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -544,

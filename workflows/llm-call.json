        "jsCode": "// Normalisieren (Mistral)\nif ($json.error) {\n  return [{ json: { text: '', error: $json.error?.message || 'LLM-Call fehlgeschlagen' } }];\n}\nconst text = $json.choices?.[0]?.message?.content || '';\nreturn [{ json: { text } }];"

      "id": "a0c5b66d-9447-46b9-b98c-47af868c8a21",
      "name": "Alle Tenants fertig (Kompaktierung)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        16,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT json_agg(t) FROM (\n    SELECT role, content, created_at FROM jonas_messages\n    WHERE tenant_id = '{{ $json.tenant_id.replace(/'/g, \"''\") }}'\n      AND created_at < (\n        SELECT MIN(created_at) FROM (\n          SELECT created_at FROM jonas_messages\n          WHERE tenant_id = '{{ $json.tenant_id.replace(/'/g, \"''\") }}'\n          ORDER BY created_at DESC LIMIT 10\n        ) recent\n      )\n      AND created_at > COALESCE(\n        (SELECT covered_until FROM jonas_conversation_summary WHERE tenant_id = '{{ $json.tenant_id.replace(/'/g, \"''\") }}'),\n        '1970-01-01'::timestamptz\n      )\n    ORDER BY created_at ASC\n  ) t) AS new_messages,\n  (SELECT summary_text FROM jonas_conversation_summary WHERE tenant_id = '{{ $json.tenant_id.replace(/'/g, \"''\") }}') AS existing_summary",
        "options": {}
      },
      "id": "f391bfa8-37b3-4efb-9c7a-2759dcd84860",
      "name": "Neue Nachrichten fuer Kompaktierung laden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        16,
        192
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const row = $json;\nconst messages = row.new_messages || [];\nconst tenant = $('Loop Over Tenants (Kompaktierung)').first().json;\nif (messages.length === 0) {\n  return [{ json: { hasNew: false } }];\n}\nconst transcript = messages.map(m => (m.role === 'user' ? 'Nutzer' : 'Jonas') + ': ' + m.content).join('\\n');\nconst newCoveredUntil = messages[messages.length - 1].created_at;\nreturn [{ json: {\n  hasNew: true,\n  tenantId: tenant.tenant_id,\n  transcript,\n  existingSummary: row.existing_summary || '',\n  newCoveredUntil\n} }];"
      },
      "id": "6e7af5bd-79f9-4c91-958a-701fd79740f3",
      "name": "Neue Nachrichten aufbereiten",
      "type": "n8n-nodes-base.code",

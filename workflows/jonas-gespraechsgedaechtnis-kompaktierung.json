        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "systemPrompt": "={{ \"Du fasst den bisherigen Gespraechsverlauf zwischen einem Immobilienmakler und seinem AI-Assistenten Jonas zusammen. \" +\n\"Du bekommst eine BESTEHENDE Zusammenfassung (kann leer sein) und NEUE Nachrichten seither. \" +\n\"Verschmelze beides zu EINER kompakten, aktuellen Zusammenfassung (max. 150 Woerter). \" +\n\"Fokus: dauerhafte Fakten, Entscheidungen, offene Punkte/Zusagen. Keine Redundanz, keine Nebensaechlichkeiten. \" +\n\"Antworte AUSSCHLIESSLICH mit dem Fliesstext der neuen Zusammenfassung auf Deutsch, ohne Anfuehrungszeichen, ohne JSON, ohne Code-Fences, ohne Einleitung.\" }}",
            "userMessage": "={{ \"Bestehende Zusammenfassung:\\n\" + ($json.existingSummary || '(noch keine)') + \"\\n\\nNeue Nachrichten seither:\\n\" + $json.transcript }}",
            "maxTokens": "300"
          },

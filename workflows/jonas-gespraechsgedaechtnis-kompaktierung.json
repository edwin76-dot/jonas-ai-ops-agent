      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const orig = $('Neue Nachrichten aufbereiten').item.json;\nlet summary = ($json.text || '').trim();\nsummary = summary.replace(/```/g, '').trim();\nif (!summary) summary = orig.existingSummary;\nreturn { json: { ...orig, summary } };"
      },
      "id": "16e33f98-6a05-4da9-aa37-6a9aabcf010f",
      "name": "Zusammenfassung parsen",

    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO jonas_conversation_summary (tenant_id, summary_text, covered_until, updated_at)\nVALUES (\n  '{{ $json.tenantId.replace(/'/g, \"''\") }}',\n  '{{ $json.summary.replace(/'/g, \"''\") }}',\n  '{{ $json.newCoveredUntil }}',\n  NOW()\n)\nON CONFLICT (tenant_id) DO UPDATE SET\n  summary_text = EXCLUDED.summary_text,\n  covered_until = EXCLUDED.covered_until,\n  updated_at = NOW();",
        "options": {}

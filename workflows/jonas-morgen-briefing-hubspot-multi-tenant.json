        3568
      ],
      "id": "e0747186-b43e-43d2-a276-3cfe15eb7af5",
      "name": "HubSpot Deals suchen",
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "numberInputs": 6
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        8784,
        3216
      ],
      "id": "e5dbcbe9-a50d-4686-a954-659eee81eecf",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "function safeAll(nodeName) {\n  try { return $(nodeName).all().map(i => i.json); } catch (e) { return []; }\n}\n\nconst events = safeAll('Events entpacken (Briefing)').filter(e => !e.error);\nconst emails = safeAll('Execute a SQL query').filter(e => !e.error);\n\nconst hubspotSkipped = safeAll('HubSpot Uebersprungen (Briefing)').length > 0;\nconst hubspotRaw = safeAll('HubSpot Deals suchen');\nconst dealsFailed = !hubspotSkipped && hubspotRaw.some(d => d.error);\nconst deals = hubspotRaw\n  .filter(d => !d.error && Array.isArray(d.results))\n  .flatMap(d => d.results);\n\nconst tokenMissing = safeAll('Kein Token (Briefing)').length > 0;\nconst calendarApiError = safeAll('Kalender Fehler (Briefing)').length > 0;\nconst eventsFailed = tokenMissing || calendarApiError;\nconst emailsFailed = safeAll('Execute a SQL query').some(e => e.error);\n\n// NEU: Graph liefert start.dateTime standardmaessig in UTC (start.timeZone\n// bestaetigt das) — explizite Konvertierung nach Europe/Berlin noetig,\n// sonst reicht der Code die rohe UTC-Stunde unveraendert an Claude durch.\nfunction toBerlinTimeStr(dateTimeStr) {\n  if (!dateTimeStr) return null;\n  // Graph-Strings kommen meist ohne 'Z'/Offset -> als UTC interpretieren\n  const iso = /Z$|[+-]\\d{2}:\\d{2}$/.test(dateTimeStr) ? dateTimeStr : dateTimeStr + 'Z';\n  const d = new Date(iso);\n  return d.toLocaleTimeString('de-DE', {\n    timeZone: 'Europe/Berlin',\n    hour: '2-digit',\n    minute: '2-digit'\n  });\n}\n\nconst eventsConverted = events.map(e => ({\n  subject: e.subject,\n  start: toBerlinTimeStr(e.start?.dateTime)\n}));\n\nconst STALE_DAYS = 7;\nconst now = Date.now();\n\nconst dealsEnriched = deals.map(d => {\n  const lastMod = d.properties?.hs_lastmodifieddate\n    ? new Date(d.properties.hs_lastmodifieddate).getTime() : null;\n  const daysSince = lastMod ? Math.floor((now - lastMod) / (1000 * 60 * 60 * 24)) : null;\n  return {\n    name: d.properties?.dealname,\n    stage: d.properties?.dealstage,\n    daysSinceMovement: daysSince,\n    stale: daysSince !== null && daysSince > STALE_DAYS\n  };\n});\n\nconst staleDeals = dealsEnriched.filter(d => d.stale);\nconst activeDeals = dealsEnriched.filter(d => !d.stale);\n\n// Identitaet des aktuell verarbeiteten Tenants explizit mitfuehren.\n// WICHTIG (Fix 17.09.2026, Cross-Tenant-Leck #2): NICHT $('Aktive Tenants laden').first()\n// verwenden -- dieser Node laeuft NUR EINMAL vor der Loop mit allen Tenants als\n// separate Items, .first() liefert deshalb IMMER dasselbe (das erste) Item, egal\n// welche Loop-Iteration gerade laeuft. Stattdessen 'Profil laden' nutzen -- der\n// laeuft PRO ITERATION genau einmal, .first() ist dort tatsaechlich sicher\n// (liefert exakt das Item der aktuellen Iteration), exakt wie tenantName unten.\nconst telegramChatId = $('Profil laden').first().json.telegram_chat_id;\nconst tenantName = ($('Profil laden').first().json.profile || {}).name || null;\n\nreturn [{\n  json: {\n    telegram_chat_id: telegramChatId,\n    tenant_name: tenantName,\n    eventsText: tokenMissing ? 'Outlook nicht verbunden.'\n      : calendarApiError ? 'Kalender konnte nicht geladen werden.'\n      : (eventsConverted.length ? JSON.stringify(eventsConverted) : 'Keine Termine heute.'),\n    emailsText: emailsFailed ? 'Emails konnten nicht geladen werden.'\n      : (emails.length ? JSON.stringify(emails) : 'Keine wichtigen Mails.'),\n    dealsText: hubspotSkipped ? 'HubSpot nicht aktiv.'\n      : dealsFailed ? 'HubSpot konnte nicht geladen werden.'\n      : JSON.stringify({ staleDeals: staleDeals.length ? staleDeals : 'keine',\n          activeDealsCount: activeDeals.length })\n  }\n}];;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

    {
      "parameters": {
        "jsCode": "const profile = $('Profil laden').first().json.profile || {};\nconst isActive = profile.briefing_aktiv !== 'false'; // Default true\nconst targetTime = profile.briefing_uhrzeit || '07:30';\nconst [targetHour, targetMinuteRaw] = targetTime.split(':').map(Number);\nconst targetMinute = targetMinuteRaw || 0;\n\nconst berlinNow = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Berlin' }));\nconst currentHour = berlinNow.getHours();\nconst currentMinute = berlinNow.getMinutes();\n\n// Trigger laeuft alle 5 Minuten -> Ziel-Minute auf denselben 5er-Raster runden,\n// robust falls briefing_uhrzeit keinen glatten 5er-Wert enthaelt (z.B. '07:32')\nconst bucket5 = m => Math.floor(m / 5) * 5;\n\nreturn [{ json: { match: isActive && currentHour === targetHour && bucket5(currentMinute) === bucket5(targetMinute), profile } }];"
      },

    {
      "parameters": {
        "jsCode": "function escapeHtml(text) {\n  return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/_/g, ' ').replace(/\\*/g, ' ').replace(/`/g, \"'\");\n}\nconst text = $json.text || 'Briefing konnte nicht formuliert werden.';\nconst chatId = $('Briefing Daten aufbereiten').first().json.telegram_chat_id;\nreturn [{ json: { reply: escapeHtml(text), telegram_chat_id: chatId } }];"
      },

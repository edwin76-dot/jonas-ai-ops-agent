    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, hubspot_contact_id\nFROM jonas_leads\nWHERE tenant_id = '{{ $json.tenant_id.replace(/'/g, \"''\") }}'\n  AND hubspot_contact_id IS NOT NULL AND hubspot_contact_id <> ''",
        "options": {}
      },
      "id": "2dd90038-5e3c-4c04-b600-095dff2b170c",

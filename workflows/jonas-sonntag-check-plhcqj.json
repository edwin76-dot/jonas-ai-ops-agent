      "id": "79d70463-7c0a-478a-ad02-16d46dfbac7a",
      "name": "Hat HubSpot-ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { skip: true, orphaned: false } }];"
      },
      "id": "bfd8515a-835b-41f9-8512-674ed4e25a0c",
      "name": "Skip Marker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        384
      ]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $json.hubspot_contact_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $('Tenant Loop').first().json.hubspot_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "17deeae4-6644-4d56-8066-b6e56a447738",
      "name": "HubSpot Kontakt pruefen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        464,
        96
      ],
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { skip: false, orphaned: false } }];"
      },
      "id": "69f22a1c-796c-4ca4-a8bb-c7963d2ae43a",
      "name": "Kontakt OK Marker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const err = $json.error;\nconst errStr = (typeof err === 'string' ? err : (err?.message || JSON.stringify(err || {}))).toString();\nconst statusCode = String(err?.httpCode || err?.statusCode || err?.status || err?.response?.statusCode || '');\nconst is404 = statusCode === '404' || /404|not found/i.test(errStr);\n\nconst leadId = $('Leads mit HubSpot-ID laden').item.json.id;\nconst leadName = $('Leads mit HubSpot-ID laden').item.json.name;\n\nreturn [{ json: {\n  skip: false,\n  orphaned: is404,\n  leadId: is404 ? leadId : null,\n  leadName: is404 ? leadName : null,\n  nonOrphanError: is404 ? null : errStr\n} }];"
      },
      "id": "d1767fbc-e870-4e5e-a3dd-94d3c0ec3b85",
      "name": "404 pruefen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst orphaned = items.filter(i => i.json.orphaned);\nconst orphanedNames = orphaned.map(i => i.json.leadName).filter(Boolean);\nconst orphanedLeadIds = orphaned.map(i => i.json.leadId).filter(Boolean);\nreturn [{ json: { orphanedCount: orphaned.length, orphanedNames, orphanedLeadIds } }];"
      },
      "id": "0fab86ec-a48a-4b72-ac37-93599e85c6bd",
      "name": "Verwaiste Links sammeln",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n  array_agg(name ORDER BY CASE priority WHEN 'A' THEN 1 WHEN 'B' THEN 2 ELSE 3 END, next_followup_at),\n  ARRAY[]::text[]\n) AS reife_lead_names\nFROM jonas_leads\nWHERE tenant_id = '{{ $('Tenant Loop').first().json.tenant_id.replace(/'/g, \"''\") }}'\n  AND hubspot_contact_id IS NULL\n  AND priority IN ('A','B')\n  AND notes IS NOT NULL AND notes <> ''",
        "options": {}
      },
      "id": "5abcd11b-a9b5-4e95-a16b-07092a25b6f7",
      "name": "Reife Leads finden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1136,
        192
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const orphanData = $('Verwaiste Links sammeln').first().json;\nconst reifeNames = $json.reife_lead_names || [];\n\nconst parts = [];\nif (orphanData.orphanedCount > 0) {\n  parts.push(`\\ud83e\\uddf9 ${orphanData.orphanedCount} verwaiste HubSpot-Verknuepfung(en) gefunden (Kontakt in HubSpot nicht mehr vorhanden): ${orphanData.orphanedNames.join(', ')}. Noch nicht automatisch bereinigt -- bitte pruefen.`);\n}\nif (reifeNames.length > 0) {\n  parts.push(`\\u2705 ${reifeNames.length} Lead(s) bereit fuer HubSpot: ${reifeNames.join(', ')}.`);\n}\n\nconst shouldSend = parts.length > 0;\nconst text = shouldSend ? `Sonntag-Check:\\n\\n${parts.join('\\n\\n')}` : '';\n\nreturn [{ json: { shouldSend, text } }];"
      },
      "id": "09e01610-ba56-4a14-a247-7cf452661a70",
      "name": "Digest bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
